{
  "name": "media-marshal",
  "version": "0.2.13+patch.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "desktop:dev": "npm run dev -w @media-marshal/desktop",
    "desktop:dev:debug": "node scripts/desktop-debug.mjs",
    "desktop:logs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types scripts/desktop-logs.mjs",
    "test:desktop:logs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --experimental-strip-types --test scripts/desktop-logs.test.mjs",
    "desktop:build": "npm run build -w @media-marshal/contracts && npm run build -w @media-marshal/media-core && npm run desktop:prepare-parser && npm run desktop:prepare-native-files && npm run build -w @media-marshal/desktop",
    "desktop:prepare-native-files": "node tools/desktop-files/prepare.mjs",
    "desktop:prepare-parser": "node tools/desktop-parser/prepare.mjs",
    "desktop:pack": "npm run check:framework -- --verify-contents && npm run desktop:build && npm run pack -w @media-marshal/desktop",
    "desktop:rebuild": "npm run rebuild -w @media-marshal/desktop",
    "typecheck": "npm run build -w @media-marshal/contracts && npm run typecheck --workspaces --if-present && npm run typecheck:desktop-agent",
    "test": "node scripts/test-electron-node.mjs",
    "test:rules": "node scripts/test-electron-node.mjs packages/media-core/src/domain",
    "test:electron-node": "node scripts/test-electron-node.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:desktop:background": "node scripts/test-desktop.mjs --background",
    "test:desktop:foreground": "node scripts/test-desktop.mjs --foreground",
    "test:packaged": "node scripts/check-desktop-artifact.mjs && node scripts/test-packaged-desktop.mjs",
    "desktop:benchmark": "node scripts/benchmark-desktop.mjs",
    "check:boundaries": "node scripts/architecture/run.mjs boundaries",
    "check:framework": "node scripts/check-framework-package.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write --ignore-unknown apps/desktop packages scripts tools/desktop-agent package.json tsconfig.base.json vitest.config.ts .prettierrc.json",
    "format:check": "prettier --check --ignore-unknown apps/desktop packages scripts tools/desktop-agent package.json tsconfig.base.json vitest.config.ts .prettierrc.json",
    "test:architecture": "node --test scripts/architecture/*.test.mjs",
    "check:structure": "node scripts/architecture/run.mjs structure",
    "check:architecture": "npm run format:check && npm run test:architecture && node scripts/architecture/run.mjs",
    "desktop:agent": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/desktop-agent/cli.ts",
    "test:desktop-agent": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tools/desktop-agent/*.test.ts",
    "typecheck:desktop-agent": "tsc -p tools/desktop-agent/tsconfig.json"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.15",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "28.1.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitepress": "1.6.4",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
