# Media Marshal 环境变量配置模板
# Media Marshal environment variable template

# ── 调试 / Debug ─────────────────────────────────────────────
# 开启后打印详细中间过程日志，生产环境保持 false
# Print detailed intermediate logs when enabled. Keep false in production.
MEDIA_MARSHAL_DEBUG=false

# ── 文件监控 / File watching ─────────────────────────────────
# 宿主机媒体目录。当前三份 Compose 均挂载到容器 /media。
# Host media directory. All three current Compose files mount it to /media.
MEDIA_DIRS=/your/media/path

# ── 端口与镜像标签（可选）/ Ports and image tag (optional) ─────
# Web UI host port.
MEDIA_MARSHAL_PORTAL_PORT=3000
# Backend API host port.
MEDIA_MARSHAL_HTTP_PORT=8080
# Image tag used by compose files that support tag selection.
# 显式值会覆盖各 Compose 的默认值；alpha / beta 使用时请改为对应标签。
# An explicit value overrides each Compose default; select the intended tag for alpha / beta.
MEDIA_MARSHAL_IMAGE_TAG=latest

# ── Beta 构建加速（可选，仅 beta compose 构建时使用）/ Beta build mirrors ──
# 留空时使用 Maven / npm 官方默认源；国内测试环境可配置为阿里或 npmmirror 镜像源
# Leave empty to use the official Maven / npm registries. You can set mirrors for local beta builds.
MAVEN_MIRROR_URL=
NPM_REGISTRY=

# ── 匹配配置 / Matching ──────────────────────────────────────
# 匹配置信度阈值（0.0-1.0），低于此值进入待确认队列
# Match confidence threshold (0.0-1.0). Results below this value enter the review queue.
MEDIA_MARSHAL_CONFIDENCE_THRESHOLD=0.8

# TMDB HTTP proxy for metadata API requests only. Leave disabled for direct access.
# Only unauthenticated HTTP proxies are supported. Use an address reachable from the backend container.
# 容器内 127.0.0.1 指向容器自身；宿主机代理请填写容器可达的地址。
MEDIA_MARSHAL_TMDB_PROXY_ENABLED=false
MEDIA_MARSHAL_TMDB_PROXY_HTTP_URL=

# ── 邮件通知（可选）/ Email notifications (optional) ──────────
# 后端保留邮件配置，当前 Web UI 入口未开放，完整投递流程待验收。
# Backend settings are retained; the email UI is unavailable and delivery still needs validation.
MEDIA_MARSHAL_EMAIL_ENABLED=false
# Notification recipient.
MEDIA_MARSHAL_EMAIL_RECIPIENT=you@example.com
# SMTP host.
MEDIA_MARSHAL_MAIL_HOST=smtp.gmail.com
# SMTP port.
MEDIA_MARSHAL_MAIL_PORT=587
# SMTP username.
MEDIA_MARSHAL_MAIL_USERNAME=your@gmail.com
# SMTP password or app password.
MEDIA_MARSHAL_MAIL_PASSWORD=your_app_password
