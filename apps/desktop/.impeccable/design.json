  "narrative": {
    "northStar": "清晰媒体工作台",
    "overview": "深蓝侧栏承载分组导航，浅灰工作区承载白色内容面，蓝色强调操作和当前路径。整体采用紧凑文字、细边框和明确分组，让目录、文件和处理状态保持可读。\n\n本文记录当前共享外壳、公共控件和总览的实现事实；方向名称来自现有方向契约，不代表用户另行批准过视觉候选方案。系统字体是产品已有约束，不引入外部字体服务。",
    "keyCharacteristics": [
      "深蓝导航、蓝色操作与浅灰工作区。",
      "以细边框和背景层次组织内容。",
      "清晰键盘焦点，文字状态与图标并用。"
    ],
    "rules": [],
    "dos": [
      "**Do** 复用蓝色操作、深蓝导航和浅灰工作区的语义分工。",
      "**Do** 保留占位文字对比度、键盘焦点和减少动态效果支持。",
      "**Do** 让长文字换行，并保持动作和状态可辨认。"
    ],
    "donts": [
      "**Don't** 仅凭颜色或统计数量表达处理成功。",
      "**Don't** 为新界面引入外部字体加载依赖。",
      "**Don't** 把总览三步配置布局作为所有业务页面的固定模板。"
    ]
  }
